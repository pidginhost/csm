ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE}

# Kernel/service tests use the same C library and Go bindings as the release;
# the builder image already carries php-cli.
# nftables: the firewall kernel tests shell out to nft, and without it they
# fail on a missing binary rather than on the behaviour they exist to check.
RUN dnf -y install systemd dbus nftables \
    && dnf clean all
