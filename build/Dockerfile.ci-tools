# CSM CI tools image -- pre-installs every tool and package the Go jobs
# would otherwise download or compile on every run: the Go toolchain go.mod
# requires (the golang image sets GOTOOLCHAIN=local, so a stale image fails
# instead of fetching a newer one), the Go analysers, node for the Web UI
# JavaScript tests, and the apt packages the test and integration jobs use.
#
# Tag: registry.pidginhost.cloud/csm/ci-tools:go-1.27.3-r1
# Build: docker build -f build/Dockerfile.ci-tools \
#          -t registry.pidginhost.cloud/csm/ci-tools:go-1.27.3-r1 .
# Push: triggered manually by build-ci-tools-image job in .gitlab-ci.yml
#
# Bump the tag suffix whenever a pinned tool version changes or a new
# tool needs to be added. The .gitlab-ci.yml CSM_CI_TOOLS_TAG variable
# points at the tag that pipelines should pull.

FROM golang:1.27.3-bookworm

# Versions kept in sync with the install commands that previously
# lived inline in .gitlab-ci.yml. When bumping any of these, bump
# the image tag in .gitlab-ci.yml CSM_CI_TOOLS_TAG so the next
# pipeline pulls the rebuilt image instead of the stale one.
# golangci-lint and gosec are also built into Dockerfile.builder for the
# tagged jobs; keep the versions equal.
ARG GOLANGCI_LINT_VERSION=v2.14.0
ARG GOVULNCHECK_VERSION=v1.8.0
ARG GOCOVER_COBERTURA_VERSION=v1.2.0
ARG GOCOVMERGE_VERSION=v0.0.0-20160331181800-b5bfa59ec0ad
# gosec: an untagged commit until a release can read Go 1.27.2 export data.
ARG GOSEC_VERSION=v2.29.1-0.20261005092323-d2b649ec0182
ARG PHCTL_VERSION=v0.6.2

# openssh-client + jq + ca-certificates for integration:, php-cli for
# the PHP Shield runtime tests and python3-cryptography for the EL8
# release verifier in test:. Installed here so no job runs apt.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        openssh-client \
        jq \
        ca-certificates \
        php-cli \
        python3-cryptography \
 && rm -rf /var/lib/apt/lists/*

# Pre-install every Go helper that pipeline jobs used to compile
# from source on every run. The golang base image already puts
# /go/bin on PATH so the binaries are callable by bare name.
#
# phctl needs GONOSUMCHECK + GOFLAGS=-mod=mod because the previous
# integration: invocation set them; preserve that contract here.
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION} \
 && go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
 && go install github.com/boumenot/gocover-cobertura@${GOCOVER_COBERTURA_VERSION} \
 && go install github.com/wadey/gocovmerge@${GOCOVMERGE_VERSION} \
 && go install github.com/securego/gosec/v2/cmd/gosec@${GOSEC_VERSION} \
 && GONOSUMCHECK='*' GOFLAGS=-mod=mod \
        go install github.com/pidginhost/phctl@${PHCTL_VERSION} \
 && rm -rf /root/.cache/go-build /go/pkg/mod

# node runs the Web UI JavaScript tests (scripts/uitest). Taken from the
# official image rather than apt: bookworm's nodejs is past upstream end of
# life. The binary needs only glibc and libstdc++, both in this base.
COPY --from=node:24.21.0-bookworm-slim /usr/local/bin/node /usr/local/bin/node
